import java.util.Scanner;

public class BuscarNumeroArreglo {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        System.out.print("Cuantos numeros tendra el arreglo? ");
        int cantidad = teclado.nextInt();
        int[] numeros = new int[cantidad];

        for (int i = 0; i < cantidad; i++) {
            System.out.print("Introduce el numero " + (i + 1) + ": ");
            numeros[i] = teclado.nextInt();
        }

        System.out.print("Que numero quieres buscar? ");
        int buscado = teclado.nextInt();
        boolean encontrado = false;
        for (int numero : numeros) {
            if (numero == buscado) {
                encontrado = true;
                break;
            }
        }

        if (encontrado) {
            System.out.println("El numero " + buscado + " esta en el arreglo.");
        } else {
            System.out.println("El numero " + buscado + " no esta en el arreglo.");
        }
        teclado.close();
    }
}
